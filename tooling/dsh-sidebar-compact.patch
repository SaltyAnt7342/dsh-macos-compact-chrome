+  .compactControl:hover {
+    background-color: var(--dsw-alias-interactive-bg-hover);
+  }
+}
+
+.compactControl:focus-visible {
+  outline: var(--dsw-focus-ring-width) solid var(--dsw-focus-ring-color, var(--dsw-alias-state-business-primary));
+  outline-offset: -2px;
+}
